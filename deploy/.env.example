DEEPSEEK_API_KEY=sk-你的DeepSeekKey
MYSQL_PASSWORD=你的MySQL真实密码
JWT_SECRET=至少32位随机字符串
INTERNAL_TOKEN=和Python共享的随机串
REDIS_PASSWORD=
# R4 向量索引：embed 容器与 Qdrant 都在宿主机单独运行
EMBED_URL=http://172.21.160.203:8010
QDRANT_URL=http://172.21.160.203:6333
QDRANT_COLLECTION=archmind_classes
# 上传文件在宿主机上的目录，相对 deploy/ 解析；服务器沿用旧部署的 ./code-workspace
WORKSPACE_DIR=./code-workspace
# R5: Python side MySQL
AGENT_MYSQL_HOST=172.21.160.203
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_DATABASE=archmind
AGENT_MYSQL_USER=archmind_agent
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_MIGRATE_USER=archmind_migrate
AGENT_MYSQL_MIGRATE_PASSWORD=
# R5 记忆：true 开启。首次上线建议把蒸馏回溯窗口设为 0，
# 观察几天确认没有异常后再改回 7。
MEMORY_ENABLED=true
MEMORY_DISTILL_MAX_AGE_DAYS=0
# R6 一轮问答走哪条链路：legacy（六选一，默认）| tools（函数调用多步循环）。
# 两条链路共用同一套记忆规则（召回 + 显式"记住…"），可以有主见地切。
AGENT_MODE=legacy

    {
      "key": "coupon_calc",
      "type": "FACT",
      "text": "优惠券计算在 CouponCalculator.calc，满减和折扣不能叠加",
      "subjectUids": ["com.hmall.marketing.CouponCalculator"]
    },
    {
      "key": "refund_flow",

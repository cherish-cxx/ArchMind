    },
    {
      "key": "coupon_limit",
      "type": "FACT",
      "text": "优惠券每人限领 2 张，超限在 CouponLimitChecker 被拒绝",
      "subjectUids": ["com.hmall.marketing.CouponLimitChecker"]

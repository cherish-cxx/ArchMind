  "cases": [
    {
      "id": "M01",
      "question": "上次那个支付回调是从哪进来的",
      "expectKey": "pay_entry",
      "mustNotRecall": ["refund_flow"]
    },
    {
      "id": "M02",
      "question": "你说的那个跨服务的断点落在哪一节",
      "expectKey": "pay_gap"
    },
    {
      "id": "M03",
      "question": "下单的时候先做了什么校验",
      "expectKey": "order_entry",
      "mustNotRecall": ["order_status"]
    },
    {
      "id": "M04",
      "question": "库存是怎么扣的，扣不动会怎样",
      "expectKey": "stock_deduct"
    },
    {
      "id": "M05",
      "question": "登录态是在哪里校验的",
      "expectKey": "auth_filter"
    },
    {
      "id": "M06",
      "question": "订单创建完购物车会被清掉吗",
      "expectKey": "cart_clear",
      "mustNotRecall": ["cart_merge"]
    },
    {
      "id": "M07",
      "question": "用户信息缓存没命中会查哪里",
      "expectKey": "user_cache"
    },
    {
      "id": "M08",
      "question": "满减和折扣能一起用吗",
      "expectKey": "coupon_calc",
      "mustNotRecall": ["coupon_limit"]
    },
    {
      "id": "M09",
      "question": "退款之后是怎么通知下游的",
      "expectKey": "refund_flow"
    },
    {
      "id": "M10",
      "question": "商品搜索的数据多久同步一次",
      "expectKey": "search_index",
      "mustNotRecall": ["search_analyzer"]
    },
    {
      "id": "M11",
      "question": "库存预占用的是什么锁",
      "expectKey": "inventory_lock",
      "mustNotRecall": ["stock_deduct"]
    },
    {
      "id": "M12",
      "question": "库存扣减失败会抛什么异常",
      "expectKey": "stock_deduct",
      "mustNotRecall": ["inventory_lock"]
    },
    {
      "id": "M13",
      "question": "支付超时多久",
      "expectKey": "pay_timeout",
      "mustNotRecall": ["pay_entry"]
    },
    {
      "id": "M14",
      "question": "支付回调失败会怎么重试",
      "expectKey": "pay_retry",
      "mustNotRecall": ["pay_entry", "pay_timeout"]
    },
    {
      "id": "M15",
      "question": "订单超时没支付会怎样",
      "expectKey": "order_timeout",
      "mustNotRecall": ["order_status"]
    },
    {
      "id": "M16",
      "question": "刚才那个支付的东西是从哪进来的",
      "expectKey": "pay_entry",
      "mustNotRecall": ["pay_timeout", "pay_retry"]
    },
    {
      "id": "M17",
      "question": "那个扣库存的地方失败了怎么办",
      "expectKey": "stock_deduct",
      "mustNotRecall": ["inventory_lock"]
    },
    {
      "id": "M18",
      "question": "登录相关的东西失败会影响主流程吗",
      "expectKey": "user_login_log",
      "mustNotRecall": ["auth_filter"]
    }
  ],

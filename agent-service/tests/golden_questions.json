      "expectedAnchorUids": [
        "com.example.demo.controller.OrderController",
        "com.example.demo.service.OrderService",
        "com.example.demo.service.impl.OrderServiceImpl",
        "com.example.demo.repository.OrderRepository"
      ],
      "mustDiscloseGap": false
    },
    {
      "id": "GQ-03",
      "question": "OrderServiceImpl 被谁调用？",
      "expectedIntent": "EXPLORE_RELATION",
      "expectedToolCalls": ["class-relations"],
      "expectedAnchorUids": [
        "com.example.demo.service.impl.OrderServiceImpl",
        "com.example.demo.controller.OrderController"
      ],
      "mustDiscloseGap": false
    },
    {
      "id": "GQ-04",
      "question": "OrderRepository 有哪些实现类？",
      "expectedIntent": "EXPLORE_RELATION",

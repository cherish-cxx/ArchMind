AGENT_PORT=8000
JAVA_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=dev-internal-token-change-me

# R5: MySQL persistence (Python connects directly).
# Runtime account only gets DML on the three agent_* tables;
# migrations use a separate account (see deploy notes).
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_DATABASE=archmind
AGENT_MYSQL_USER=archmind_agent
AGENT_MYSQL_PASSWORD=

# R6 一轮问答走哪条链路：legacy（六选一，默认）| tools（函数调用多步循环）
AGENT_MODE=legacy
